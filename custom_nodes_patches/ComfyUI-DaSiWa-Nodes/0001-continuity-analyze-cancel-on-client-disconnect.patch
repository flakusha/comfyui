+def _disconnect_cancel(request):
+    """An event set when the browser walks away from this request.
+
+    The analyze draft runs outside the queue, so no Cancel ever sets ComfyUI's
+    interrupt flag for it; a closed dialog left the Forge LLM generating for
+    nobody until it answered. aiohttp never cancels a handler whose client has
+    left — it tears the connection down around it (the handler's transport goes
+    closing, then None) — so a watcher polls exactly that and sets the event
+    the draft's streaming backend checks between lines.
+    """
+    gone = asyncio.Event()
+
+    async def watch():
+        while True:
+            transport = getattr(request, "transport", None)
+            if transport is None or transport.is_closing():
+                gone.set()
+                return
+            await asyncio.sleep(0.25)
+
+    watcher = asyncio.create_task(watch())
+    return gone, watcher
+
+
