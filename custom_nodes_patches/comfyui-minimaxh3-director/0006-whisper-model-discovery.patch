+        if key not in state:
+            raise ValueError("%s is not a Whisper checkpoint: no %s." % (name, key))
+
+    def side(prefix):
+        layers = [int(m.group(1)) for key in state for m in [re.match(prefix + r"\.blocks\.(\d+)\.", key)] if m]
