+def _flat_tae_decoder(sd):
+    """Rebuild the 2D taeh3 decoder (the recommended tiny preview VAE, e.g. Kijai's TAE) from its flat
+    checkpoint. Its keys are positional module indices: 'N.conv.0.weight' is a Block, 'N.weight' a plain
+    conv, and the gaps are the parameterless Clamp, ReLU and Upsample modules."""
+    from comfy.taesd.taesd import Block, Clamp, conv
+    by_index = {}
+    for key, value in sd.items():
+        head, _, rest = key.partition(".")
+        if not head.isdigit():
+            raise ValueError("unexpected key '%s' for a flat taeh3 decoder" % key)
+        by_index.setdefault(int(head), {})[rest] = value
+    modules = []
+    for index in range(max(by_index) + 1):
+        entry = by_index.get(index)
+        if entry is None:
+            modules.append(Clamp() if index == 0 else nn.ReLU() if index == 2 else nn.Upsample(scale_factor=2))
+        elif "conv.0.weight" in entry:
+            weight = entry["conv.0.weight"]
+            modules.append(Block(weight.shape[1], weight.shape[0]))
+        elif "weight" in entry:
+            modules.append(conv(entry["weight"].shape[1], entry["weight"].shape[0], bias="bias" in entry))
+        else:
+            raise ValueError("unrecognized taeh3 decoder module at index %d: %s" % (index, sorted(entry)))
+    return nn.Sequential(*modules)
+
+
+class FlatTAEH3:
+    """Decode-only 2D taeh3 preview decoder. decode() returns the TAEHV VAE's [1, T, H, W, 3] layout, so
+    the preview transport needs no branch for it."""
+
+    def __init__(self, sd):
+        model = _flat_tae_decoder(sd)
+        model.load_state_dict(sd)
+        self.dtype = comfy.model_management.vae_dtype(comfy.model_management.vae_device())
+        self.model = model.eval().to(device=comfy.model_management.vae_device(), dtype=self.dtype)
+        self.latent_channels = model[1].weight.shape[1]
+
+    def decode(self, latent):
+        """[1, C, T, H, W] latents -> [1, T, H * 16, W * 16, 3] pictures, float32 on the input device."""
+        frames = [self.model(frame.unsqueeze(0))[0]
+                  for frame in latent.to(device=self.model[1].weight.device, dtype=self.dtype)[0].movedim(0, 1)]
+        return torch.stack(frames).movedim(1, 3).unsqueeze(0).to(device=latent.device, dtype=torch.float32)
+
+
 def require_taehv(vae):
+    if isinstance(vae, FlatTAEH3):
+        return vae
     stage = getattr(vae, "first_stage_model", None)
